{
  "name": "punchline",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev dist --d1 DB=punchline-db --persist-to .wrangler/state --compatibility-date 2024-09-09",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:init": "wrangler d1 execute punchline-db --local --persist-to .wrangler/state --file=db/schema.sql",
    "db:migrate": "wrangler d1 execute punchline-db --file=db/schema.sql",
    "deploy": "pnpm build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "hono": "^4.13.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "wrangler": "^4.130.0"
  }
}
